{
  "name": "jev-job-search-windows",
  "version": "1.6.0",
  "private": true,
  "description": "The Windows build of jev-job-search: finds software, data and IT roles, rates them with JEV, fills and verifies each application in Chrome, and submits it.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joe-sida/jev-job-search-windows.git"
  },
  "homepage": "https://github.com/joe-sida/jev-job-search-windows#readme",
  "bugs": {
    "url": "https://github.com/joe-sida/jev-job-search-windows/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "jev": "./bin/jev.js",
    "jev-job-search": "./bin/jev.js"
  },
  "scripts": {
    "jev": "tsx src/cli.ts",
    "setup": "tsx src/cli.ts doctor",
    "doctor": "tsx src/cli.ts doctor",
    "discover": "tsx src/cli.ts discover",
    "apply": "tsx src/cli.ts apply",
    "tailor": "tsx src/cli.ts tailor",
    "log": "tsx src/cli.ts log",
    "status": "tsx src/cli.ts status",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-types": "tsc --noEmit",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
